<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>relearn</AssemblyName>
    <RootNamespace>ReLearn</RootNamespace>
    <Version>0.1.0</Version>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS8618</NoWarn>
    <!-- Roslyn 4.11 MSBuildWorkspace loads projects out-of-process (BuildHost),
         so MSBuild assemblies copied by transitive packages are harmless. -->
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- dotnet tool packaging: dotnet pack -> dotnet tool install -g ReLearn.Analyzer -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>relearn</ToolCommandName>
    <PackageId>ReLearn.Analyzer</PackageId>
    <Description>Roslyn-based legacy .NET knowledge extractor for modernization agents (Spec Kit / BMAD).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\targets\*.json" Link="targets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
